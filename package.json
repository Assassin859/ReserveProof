{
  "name": "reserveproof",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source proof of reserves + ExitRight for USDG and Robinhood Stock Tokens",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:count": "ts-node scripts/test-count.ts",
    "clean": "hardhat clean",
    "web:sync": "hardhat compile && ts-node scripts/sync-web.ts",
    "cli:build": "ts-node packages/cli/src/index.ts build",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:rh": "hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:arb": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "disputes:redeploy:rh": "hardhat run scripts/redeploy-disputes.ts --network robinhoodTestnet",
    "disputes:redeploy:arb": "hardhat run scripts/redeploy-disputes.ts --network arbitrumSepolia",
    "vault:deploy:rh": "hardhat run scripts/deploy-vault.ts --network robinhoodTestnet",
    "vault:deploy:arb": "hardhat run scripts/deploy-vault.ts --network arbitrumSepolia",
    "morpho:deploy:rh": "hardhat run scripts/deploy-morpho-oracle.ts --network robinhoodTestnet",
    "morpho:deploy:arb": "hardhat run scripts/deploy-morpho-oracle.ts --network arbitrumSepolia",
    "verify:rh": "hardhat run scripts/verify.ts --network robinhoodTestnet",
    "verify:arb": "hardhat run scripts/verify.ts --network arbitrumSepolia",
    "verify:sourcify": "ts-node scripts/verify-sourcify.ts",
    "wallets:mainnet": "ts-node scripts/make-mainnet-wallets.ts",
    "deploy:rhmain": "hardhat run scripts/deploy-mainnet.ts --network robinhoodMainnet",
    "ops:cycle:rhmain": "hardhat run scripts/ops-cycle.ts --network robinhoodMainnet",
    "status:rhmain": "hardhat run scripts/status.ts --network robinhoodMainnet",
    "verify:rhmain": "hardhat run scripts/verify.ts --network robinhoodMainnet",
    "market:size": "ts-node scripts/market-size.ts",
    "wallets": "ts-node scripts/make-wallets.ts",
    "status:rh": "hardhat run scripts/status.ts --network robinhoodTestnet",
    "status:arb": "hardhat run scripts/status.ts --network arbitrumSepolia",
    "whatif:check:rh": "hardhat run scripts/whatif-check.ts --network robinhoodTestnet",
    "whatif:check:arb": "hardhat run scripts/whatif-check.ts --network arbitrumSepolia",
    "ops:cycle:rh": "hardhat run scripts/ops-cycle.ts --network robinhoodTestnet",
    "ops:cycle:arb": "hardhat run scripts/ops-cycle.ts --network arbitrumSepolia",
    "exitright:setup": "hardhat run scripts/exitright-setup.ts --network robinhoodTestnet",
    "exitright:demo": "hardhat run scripts/exitright-demo.ts --network robinhoodTestnet",
    "demo:node": "hardhat node",
    "demo:deploy": "hardhat run scripts/deploy.ts --network localhost",
    "demo:cli": "ts-node scripts/demo-cli-build.ts",
    "demo:web": "npm run dev --prefix packages/web",
    "demo:warp": "hardhat run scripts/demo-warp.ts --network localhost",
    "demo:prepare": "hardhat run scripts/demo-scene.ts --network localhost",
    "demo:setup": "ts-node scripts/demo-setup.ts",
    "demo:snapshot": "hardhat run scripts/demo-snapshot.ts --network localhost",
    "demo:reset": "hardhat run scripts/demo-reset.ts --network localhost",
    "ops:publish": "hardhat run scripts/publish-epoch.ts --network localhost",
    "ops:sample": "hardhat run scripts/record-samples.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^4.5.0",
    "dotenv": "^18.0.4",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0"
  }
}
